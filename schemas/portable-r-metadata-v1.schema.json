{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rpackit/runtime/main/schemas/portable-r-metadata-v1.schema.json",
  "title": "rpackit portable R artifact metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "r_version",
    "platform",
    "arch",
    "artifact_url",
    "sha256",
    "archive_format",
    "r_home",
    "rscript",
    "library"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "r_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "platform": {
      "enum": ["windows", "macos", "linux"]
    },
    "arch": {
      "enum": ["x86_64", "arm64"]
    },
    "artifact_url": {
      "type": "string",
      "pattern": "^https://"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "archive_format": {
      "enum": ["zip", "tar.zst", "tar.gz"]
    },
    "r_home": {
      "type": "string",
      "minLength": 1
    },
    "rscript": {
      "type": "string",
      "minLength": 1
    },
    "library": {
      "type": "string",
      "minLength": 1
    }
  }
}
